{
  "name": "dreadcast_simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.4.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "analyze": "tsc -b && vite build --mode analyze",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest run",
    "format": "prettier --write \"{src,server,scripts}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"{src,server,scripts}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "dev:api": "tsx watch --env-file=.env.local server/main.ts",
    "api:diff": "tsx scripts/api-diff.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/chakra-petch": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "effect": "4.0.0-rc.117",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@tanstack/eslint-plugin-query": "^5.103.2",
    "@tanstack/react-query-devtools": "5.103.2",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^24.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9.39.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vercel": "^50.28.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
