{
  "buildCommand": "yarn build",
  "installCommand": "mkdir -p .vercel/cache/corepack && echo '{\"type\":\"commonjs\"}' > .vercel/cache/corepack/package.json && yarn install --immutable",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/server.ts": {
      "includeFiles": "server/**"
    }
  },
  "redirects": [
    {
      "source": "/shared/:id",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server?__path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
