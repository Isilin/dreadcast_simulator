{
  "name": "dreadcast_simulator",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "yarn@4.4.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "analyze": "tsc -b && vite build --mode analyze",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest run",
    "format": "prettier --write \"{src,server,scripts}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"{src,server,scripts}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "dev:api": "PORT=3001 tsx watch --env-file=.env.local server/node.ts",
    "build:server": "node scripts/build-server.mjs",
    "db:generate": "drizzle-kit generate --config server/db/drizzle.config.ts",
    "start": "node dist-server/index.js",
    "api:diff": "tsx scripts/api-diff.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/chakra-petch": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-openapi": "^1.6.3",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.23",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.1",
    "@tanstack/eslint-plugin-query": "^5.108.4",
    "@tanstack/react-query-devtools": "5.108.4",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.13.0",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
